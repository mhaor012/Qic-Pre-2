author = {Zhao, Ming-Jing and Li, Zong-Guo and Li-Jost, Xianqing and Fei, Shao-Ming},
title = {Multiqubit quantum teleportation},
journal = {Journal of Physics A: Mathematical and Theoretical},
abstract = {We provide a class of six-qubit states for three-qubit perfect teleportation. These states include the six-qubit cluster states as a special class. We generalize this class of six-qubit states to 2n-qubit pure states for n-qubit teleportation, n ⩾ 1. These states can be also used for 2n-bit classical information transmission in dense coding.}
